# ---------------------------------------------------------------------------
# ReSource AI — backend environment variables
# Copy to .env and fill in only the integrations you have keys for.
# Every integration has a working, clearly-labelled demo fallback.
# ---------------------------------------------------------------------------

# Supabase PostgreSQL (server-side only — never put these in the frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API for material analysis / requirement extraction / offer assistance
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Google Places / Maps for real business discovery and distance data
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=

# CORS + storage
FRONTEND_URL=http://localhost:5173
DATA_DIR=./data

# Environment mode. production requires TOKEN_SECRET and disables the built-in secret.
APP_ENV=demo
# Keep true for the public hackathon demo. Set false to require sign-in for all
# state-changing API actions (read-only/compute endpoints remain public).
ALLOW_ANONYMOUS_DEMO=true

# Secret used to sign session tokens. Set a long random value in production;
# changing it invalidates existing browser sessions.
TOKEN_SECRET=

# Configurable demo matching weights (must total 1.0)
MATCH_WEIGHT_MATERIAL=0.40
MATCH_WEIGHT_QUANTITY=0.25
MATCH_WEIGHT_LOCATION=0.20
MATCH_WEIGHT_QUALITY=0.155
